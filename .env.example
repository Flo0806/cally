# Location for the weather forecast (Open-Meteo)
NUXT_WEATHER_LATITUDE=
NUXT_WEATHER_LONGITUDE=

# Session cookie secret, at least 32 characters: openssl rand -base64 32
NUXT_APP_SECRET=

# nuxt-auth-utils: session seal (at least 32 characters: openssl rand -hex 32)
NUXT_SESSION_PASSWORD=

# Google OAuth client (Web application). Redirect URI: <origin>/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# Behind the proxy the request looks like http, so name the public URL explicitly
NUXT_OAUTH_GOOGLE_REDIRECT_URL=

# Comma separated Google accounts that may log in
NUXT_ALLOWED_EMAILS=

# Local development only: skip the login entirely
NUXT_PUBLIC_AUTH_DISABLED=

# TomTom Routing API (developer.tomtom.com, free tier). Optional, adds live and predicted traffic.
NUXT_TOMTOM_KEY=
